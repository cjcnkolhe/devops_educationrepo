
pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK17'
    }

    environment {

        // Docker Hub
        DOCKER_IMAGE = 'nanducjc123/educationapprepo'

        // SonarQube
        SONAR_HOST = 'http://13.201.5.90:9000'
        SONAR_PROJECT_KEY = 'educationapp'

        // AWS Configuration
        AWS_REGION = 'ap-south-1'
        EKS_CLUSTER = 'java-eks-cluster'

        // Kubernetes Configuration
        NAMESPACE = 'education'
        DEPLOYMENT = 'educationapp'
        CONTAINER = 'educationapp'
        SERVICE = 'educationapp-service'

        // Kubeconfig
        KUBECONFIG = '/var/lib/jenkins/.kube/config'
    }

    stages {

        // --------------------------------
        // 1. Git Checkout
        // --------------------------------

        stage('Git Checkout') {
            steps {
                echo 'Checking out GitHub Repository...'
                checkout scm
            }
        }

        // --------------------------------
        // 2. Maven Build
        // --------------------------------

        stage('Maven Build') {
            steps {
                echo 'Building Spring Boot Application...'

                sh '''
                    mvn clean package -DskipTests

                    echo "Checking WAR File..."

                    ls -lh target/*.war
                '''
            }
        }

        // --------------------------------
        // 3. SonarQube Analysis
        // --------------------------------

        stage('SonarQube Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x

                        echo "Starting SonarQube Analysis..."

                        mvn -B \
                        org.sonarsource.scanner.maven:sonar-maven-plugin:3.11.0.3922:sonar \
                        -Dsonar.host.url=${SONAR_HOST} \
                        -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                        -Dsonar.token="$SONAR_TOKEN"

                        echo "SonarQube Analysis Completed!"
                    '''
                }
            }
        }

        // --------------------------------
        // 4. Docker Build
        // --------------------------------

        stage('Docker Build') {
            steps {
                echo 'Building Docker Image...'

                sh '''
                    docker build \
                    -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                    -t ${DOCKER_IMAGE}:latest .

                    docker images
                '''
            }
        }

        // --------------------------------
        // 5. Docker Hub Push
        // --------------------------------

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set +x

                        echo "$DOCKER_PASS" | docker login \
                        -u "$DOCKER_USER" --password-stdin

                        docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}

                        docker push ${DOCKER_IMAGE}:latest

                        docker logout

                        echo "Docker Image Push Successful!"
                    '''
                }
            }
        }

        // --------------------------------
        // 6. Connect to AWS EKS
        // --------------------------------

        stage('Connect to EKS') {
            steps {
                sh '''
                    echo "Connecting to AWS EKS..."

                    mkdir -p /var/lib/jenkins/.kube

                    aws eks update-kubeconfig \
                    --region ${AWS_REGION} \
                    --name ${EKS_CLUSTER} \
                    --kubeconfig ${KUBECONFIG}

                    export KUBECONFIG=${KUBECONFIG}

                    echo "Checking Cluster..."

                    kubectl cluster-info

                    echo "Checking Nodes..."

                    kubectl get nodes -o wide

                    echo "Creating Namespace..."

                    kubectl create namespace ${NAMESPACE} \
                    --dry-run=client -o yaml | kubectl apply -f -

                    echo "Namespace Ready!"
                '''
            }
        }

        // --------------------------------
        // 7. Deploy Application to EKS
        // --------------------------------

        stage('Deploy to EKS') {
            steps {
                sh '''
                    export KUBECONFIG=${KUBECONFIG}

                    echo "Creating Deployment..."

                    kubectl create deployment ${DEPLOYMENT} \
                    --image=${DOCKER_IMAGE}:${BUILD_NUMBER} \
                    --port=8080 \
                    -n ${NAMESPACE} \
                    --dry-run=client -o yaml | kubectl apply -f -

                    echo "Updating Container Image..."

                    kubectl set image deployment/${DEPLOYMENT} \
                    ${CONTAINER}=${DOCKER_IMAGE}:${BUILD_NUMBER} \
                    -n ${NAMESPACE}

                    echo "Setting Image Pull Policy..."

                    kubectl patch deployment ${DEPLOYMENT} \
                    -n ${NAMESPACE} \
                    -p '{"spec":{"template":{"spec":{"containers":[{"name":"educationapp","imagePullPolicy":"Always"}]}}}}'

                    echo "Creating LoadBalancer Service..."

                    kubectl expose deployment ${DEPLOYMENT} \
                    --name=${SERVICE} \
                    --type=LoadBalancer \
                    --port=80 \
                    --target-port=8080 \
                    -n ${NAMESPACE} \
                    --dry-run=client -o yaml | kubectl apply -f -

                    echo "Deployment Commands Completed!"
                '''
            }
        }

        // --------------------------------
        // 8. Verify Deployment
        // --------------------------------

        stage('EKS Deployment Verification') {
            steps {
                sh '''
                    export KUBECONFIG=${KUBECONFIG}

                    echo "Checking Deployment Rollout..."

                    kubectl rollout status deployment/${DEPLOYMENT} \
                    -n ${NAMESPACE} \
                    --timeout=300s

                    echo "Checking Pods..."

                    kubectl get pods -n ${NAMESPACE} -o wide

                    echo "Checking Deployment..."

                    kubectl get deployments -n ${NAMESPACE}

                    echo "Checking Services..."

                    kubectl get services -n ${NAMESPACE}

                    echo "EKS Deployment Successful!"
                '''
            }
        }
    }

    // --------------------------------
    // 9. Post Actions
    // --------------------------------

    post {

        success {
            echo '''
            ==========================================
                JENKINS PIPELINE SUCCESS!
            ==========================================
                Git Checkout       : SUCCESS
                Maven Build        : SUCCESS
                SonarQube Analysis : SUCCESS
                Docker Build       : SUCCESS
                Docker Push        : SUCCESS
                AWS EKS Connection : SUCCESS
                Kubernetes Deploy : SUCCESS
            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
                JENKINS PIPELINE FAILED!
                Check Console Output.
            ==========================================
            '''
        }

        always {
            echo 'Jenkins Pipeline Execution Finished.'
        }
    }
}
