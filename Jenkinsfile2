
pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK17'
    }

    environment {

        // Docker Hub
        DOCKER_IMAGE = 'nanducjc123/educationapprepo'

        // SonarQube
        SONAR_HOST = 'http://13.201.5.90:9000'
        SONAR_PROJECT_KEY = 'my-project'

        // AWS EKS
        AWS_REGION = 'ap-south-1'
        EKS_CLUSTER = 'java-eks-cluster'
        K8S_NAMESPACE = 'default'

        // Kubernetes
        APP_NAME = 'educationapp'
        SERVICE_NAME = 'educationapp-service'
    }

    stages {

        // 1. Git Checkout
        stage('Git Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/cjcnkolhe/educationapp.git'
            }
        }

        // 2. Maven Build
        stage('Maven Build') {
            steps {
                sh '''
                    java -version
                    mvn -version

                    mvn clean package
                '''
            }
        }

        // 3. SonarQube Analysis
        stage('SonarQube Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    sh '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar \
                        -Dsonar.projectKey=$SONAR_PROJECT_KEY \
                        -Dsonar.projectName=$SONAR_PROJECT_KEY \
                        -Dsonar.host.url=$SONAR_HOST \
                        -Dsonar.token=$SONAR_TOKEN \
                        -Dsonar.java.binaries=target/classes
                    '''
                }
            }
        }

        // 4. Docker Build
        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                    -t $DOCKER_IMAGE:$BUILD_NUMBER \
                    -t $DOCKER_IMAGE:latest .
                '''
            }
        }

        // 5. Docker Login & Push
        stage('Docker Login & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set +x

                        echo "$DOCKER_PASS" | docker login \
                        -u "$DOCKER_USER" \
                        --password-stdin

                        docker push $DOCKER_IMAGE:$BUILD_NUMBER
                        docker push $DOCKER_IMAGE:latest

                        docker logout
                    '''
                }
            }
        }

        // 6. AWS EKS Connection
        stage('AWS EKS Connect') {
            steps {
                sh '''
                    aws --version
                    kubectl version --client

                    aws sts get-caller-identity

                    aws eks update-kubeconfig \
                    --region $AWS_REGION \
                    --name $EKS_CLUSTER

                    kubectl get nodes

                    kubectl get namespace $K8S_NAMESPACE
                '''
            }
        }

        // 7. Kubernetes Deployment
        stage('Kubernetes Deployment') {
            steps {
                sh '''
                    echo "Applying Deployment YAML..."

                    kubectl apply -f k8s/deployment.yaml \
                    -n $K8S_NAMESPACE

                    echo "Updating Docker Image..."

                    kubectl set image deployment/$APP_NAME \
                    $APP_NAME=$DOCKER_IMAGE:$BUILD_NUMBER \
                    -n $K8S_NAMESPACE

                    echo "Deployment YAML Applied!"
                '''
            }
        }

        // 8. Kubernetes Service
        stage('Kubernetes Service') {
            steps {
                sh '''
                    echo "Applying Service YAML..."

                    kubectl apply -f k8s/service.yaml \
                    -n $K8S_NAMESPACE

                    echo "Service YAML Applied!"
                '''
            }
        }

        // 9. EKS Verification
        stage('EKS Verification') {
            steps {
                sh '''
                    echo "Waiting for Deployment..."

                    kubectl rollout status deployment/$APP_NAME \
                    -n $K8S_NAMESPACE \
                    --timeout=300s

                    echo "Checking Pods..."

                    kubectl get pods -n $K8S_NAMESPACE -o wide

                    echo "Checking Deployment..."

                    kubectl get deployments -n $K8S_NAMESPACE

                    echo "Checking Services..."

                    kubectl get svc -n $K8S_NAMESPACE
                '''
            }
        }

        // 10. LoadBalancer Verification
        stage('LoadBalancer Verification') {
            steps {
                sh '''
                    echo "Waiting for LoadBalancer DNS..."

                    LB_HOST=""

                    for i in $(seq 1 20); do

                        LB_HOST=$(kubectl get svc $SERVICE_NAME \
                        -n $K8S_NAMESPACE \
                        -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')

                        if [ -z "$LB_HOST" ]; then
                            LB_HOST=$(kubectl get svc $SERVICE_NAME \
                            -n $K8S_NAMESPACE \
                            -o jsonpath='{.status.loadBalancer.ingress[0].ip}')
                        fi

                        if [ -n "$LB_HOST" ]; then
                            echo "Application URL: http://$LB_HOST"
                            break
                        fi

                        echo "Waiting for LoadBalancer..."
                        sleep 15
                    done

                    if [ -z "$LB_HOST" ]; then
                        echo "LoadBalancer address is pending."
                        exit 1
                    fi
                '''
            }
        }
    }

    post {

        success {
            echo '======================================'
            echo 'PIPELINE EXECUTED SUCCESSFULLY!'
            echo '======================================'

            echo 'Maven Build: SUCCESS'
            echo 'SonarQube Analysis: SUCCESS'
            echo 'Docker Hub Push: SUCCESS'
            echo 'AWS EKS Connection: SUCCESS'
            echo 'Kubernetes Deployment: SUCCESS'
            echo 'Kubernetes Service: SUCCESS'
            echo 'Application: educationapp'
            echo 'Replicas: 2'
            echo 'Namespace: default'
        }

        failure {
            echo 'PIPELINE EXECUTION FAILED!'
            echo 'Check Jenkins Console Output!'
        }

        always {
            echo 'Jenkins Pipeline Execution Finished.'
        }
    }
}
