
pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK17'
    }

    environment {
        DOCKER_IMAGE     = 'nanducjc123/educationapprepo'
        SONAR_HOST       = 'http://13.201.5.90:9000'

        AWS_REGION       = 'ap-south-1'
        EKS_CLUSTER_NAME = 'java-eks-cluster'

        K8S_NAMESPACE    = 'default'
        DEPLOYMENT_NAME  = 'educationapp'
        CONTAINER_NAME   = 'educationapp'

        KUBECONFIG       = '/var/lib/jenkins/.kube/config'
        KUBECTL_BIN      = '/usr/bin/kubectl'
        PATH             = "/usr/local/bin:/usr/bin:${env.PATH}"
    }

    stages {

        // 1. Git Checkout
        stage('Git Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/cjcnkolhe/devops_educationrepo.git'
            }
        }

        // 2. Maven Build
        stage('Maven Build') {
            steps {
                sh '''
                    set -e
                    echo "Building Spring Boot Application..."
                    mvn clean package
                '''
            }
        }

        // 3. SonarQube Analysis
        stage('SonarQube Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar \
                        -Dsonar.projectKey=my-project \
                        -Dsonar.projectName=my-project \
                        -Dsonar.host.url=$SONAR_HOST \
                        -Dsonar.token=$SONAR_TOKEN
                    '''
                }
            }
        }

        // 4. Docker Build
        stage('Docker Build') {
            steps {
                sh '''
                    set -e

                    echo "Building Docker Image..."

                    docker build \
                        -t $DOCKER_IMAGE:$BUILD_NUMBER \
                        -t $DOCKER_IMAGE:latest .
                '''
            }
        }

        // 5. Docker Login & Push
        stage('Docker Login & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -e
                        set +x

                        echo "$DOCKER_PASS" | docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin

                        docker push $DOCKER_IMAGE:$BUILD_NUMBER
                        docker push $DOCKER_IMAGE:latest

                        docker logout
                    '''
                }
            }
        }

        // 6. AWS EKS Connect
        stage('AWS EKS Connect') {
            steps {
                sh '''
                    set -e

                    echo "Checking AWS CLI..."
                    aws --version

                    echo "Checking kubectl..."
                    $KUBECTL_BIN version --client

                    echo "Checking AWS Identity..."
                    aws sts get-caller-identity

                    echo "Connecting to AWS EKS..."

                    mkdir -p "$(dirname "$KUBECONFIG")"

                    aws eks update-kubeconfig \
                        --region $AWS_REGION \
                        --name $EKS_CLUSTER_NAME \
                        --kubeconfig $KUBECONFIG

                    echo "Checking EKS Cluster..."
                    $KUBECTL_BIN cluster-info

                    echo "Checking Kubernetes Nodes..."
                    $KUBECTL_BIN get nodes -o wide
                '''
            }
        }

        // 7. Deploy to EKS
        stage('Deploy to EKS') {
            steps {
                sh '''
                    set -e

                    echo "Applying Kubernetes Deployment..."

                    $KUBECTL_BIN apply \
                        -f k8s/deployment.yaml \
                        -n $K8S_NAMESPACE

                    echo "Applying Kubernetes Service..."

                    $KUBECTL_BIN apply \
                        -f k8s/service.yaml \
                        -n $K8S_NAMESPACE

                    echo "Updating Docker Image..."

                    $KUBECTL_BIN set image \
                        deployment/$DEPLOYMENT_NAME \
                        $CONTAINER_NAME=$DOCKER_IMAGE:$BUILD_NUMBER \
                        -n $K8S_NAMESPACE

                    echo "Waiting for Deployment..."

                    $KUBECTL_BIN rollout status \
                        deployment/$DEPLOYMENT_NAME \
                        -n $K8S_NAMESPACE \
                        --timeout=300s
                '''
            }
        }

        // 8. EKS Deployment Verification
        stage('EKS Deployment Verification') {
            steps {
                sh '''
                    set -e

                    echo "========== EKS NODES =========="
                    $KUBECTL_BIN get nodes -o wide

                    echo "========== PODS =========="
                    $KUBECTL_BIN get pods \
                        -n $K8S_NAMESPACE -o wide

                    echo "========== DEPLOYMENT =========="
                    $KUBECTL_BIN get deployment \
                        -n $K8S_NAMESPACE

                    echo "========== SERVICES =========="
                    $KUBECTL_BIN get services \
                        -n $K8S_NAMESPACE

                    echo "========== APPLICATION STATUS =========="
                    $KUBECTL_BIN rollout status \
                        deployment/$DEPLOYMENT_NAME \
                        -n $K8S_NAMESPACE \
                        --timeout=300s
                '''
            }
        }
    }

    post {
        success {
            echo '''
            ======================================
            JENKINS PIPELINE SUCCESSFUL!
            Docker Image Pushed Successfully!
            Application Deployed to AWS EKS!
            Cluster: java-eks-cluster
            ======================================
            '''
        }

        failure {
            echo '''
            ======================================
            JENKINS PIPELINE FAILED!
            Check Jenkins Console Output.
            ======================================
            '''
        }

        always {
            echo 'Jenkins Pipeline Execution Finished.'
        }
    }
}
